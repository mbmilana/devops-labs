# ==========================================
# Секреты и учетные данные (КРИТИЧЕСКИ ВАЖНО)
# ==========================================
*.pem
*.tfvars
*.tfvars.json
*.pkrvars.hcl
.env
.env.*
secrets.yml
credentials.yml
*.ansible_vault

# ==========================================
# Terraform & OpenTofu
# ==========================================
# Исключаем локальную директорию плагинов и стейта
.terraform/
.tofu/
*.tfstate
*.tfstate.*

# Исключаем файлы блокировки при крашах
*.hcl.lock
.terraform.lock.hcl

# ==========================================
# Ansible
# ==========================================
*.retry
.ansible_cache/
galaxy_roles/

# ==========================================
# Docker & Kubernetes
# ==========================================
.dockerignore
# Если логи контейнеров пишутся локально
*.log
# Файлы конфигурации локального кластера (например, K3s/Minikube)
.kube/
kubeconfig

# ==========================================
# Packer
# ==========================================
packer_cache/
output-*/

# ==========================================
# Vagrant
# ==========================================
.vagrant/

# ==========================================
# Python (скрипты автоматизации)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/

# ==========================================
# Системные файлы и логи
# ==========================================
.DS_Store
Thumbs.db
*.log
